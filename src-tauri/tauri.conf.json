{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Conductor",
    "version":  "0.1.4",
    "identifier":  "io.github.amppa.conductor",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Conductor",
                                    "dragDropEnabled":  false,
                                    "width":  960,
                                    "height":  620,
                                    "minWidth":  800,
                                    "minHeight":  520,
                                    "resizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  [
                                     "../vendor/autohotkey/AutoHotkey64.exe",
                                     "../vendor/autohotkey/license.txt",
                                     "../engine/GestureEngine.ahk"
                                 ],
                   "targets":  "all",
                   "windows":  {
                                   "wix":  {
                                               "language":  "en-US"
                                           }
                               }
               }
}
